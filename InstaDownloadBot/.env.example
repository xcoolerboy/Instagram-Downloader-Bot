# ===== Telegram =====
# توکن رباتت رو از @BotFather بگیر و اینجا بذار
BOT_TOKEN=123456:ABC-YOUR-TOKEN-HERE

# آیدی عددی ادمین‌ها (از @userinfobot بگیر). چند ادمین رو با کاما جدا کن
# مثال: 123456789,987654321
ADMIN_IDS=123456789

# ===== مسیرها =====
# محل ذخیره موقت ویدیوها (بعد از ارسال خودکار پاک می‌شه)
DOWNLOAD_DIR=downloads
# مسیر فایل دیتابیس SQLite
DB_PATH=bot.db

# ===== محدودیت‌ها =====
# حداکثر حجم فایل ارسالی به تلگرام (مگابایت). ربات‌ها معمولا تا ۵۰ مگ می‌تونن
MAX_FILE_MB=50

# ===== ضدفلود / محافظت از هاست =====
# حداقل فاصله بین دو درخواست دانلودِ هر کاربر (ثانیه). ۰ یعنی غیرفعال
# روی ۶۰ یعنی هر کاربر هر ۱ دقیقه یک ریلز می‌تونه بگیره
COOLDOWN_SECONDS=60
# سقف تعداد دانلودهای هم‌زمان روی کل ربات. ۰ یعنی نامحدود
MAX_CONCURRENT_DOWNLOADS=3

# ===== کش / کپی‌رایت =====
# عمرِ کشِ مدیا (روز): ریلزهای قدیمی‌تر از این از کش پاک می‌شن تا ربات «آرشیوِ
# دائمیِ محتوای دیگران» نشه و ریسکِ کپی‌رایت کم بشه. ۰ یعنی هیچ‌وقت منقضی نشه.
CACHE_TTL_DAYS=30

# ===== کوکی‌های اینستاگرام (اختیاری ولی توصیه‌شده) =====
# کوکی sessionid یه اکانت اینستا موفقیت دانلود رو خیلی بالا می‌بره.
# می‌تونی چند کوکی رو با «،» (کاما) جدا کنی تا اگه یکی ریت‌لیمیت/منقضی شد،
# ربات خودکار بره سراغ بعدی و با سوختن یه کوکی از کار نیفته.
# مثال: INSTAGRAM_SESSIONID=cookie_account1,cookie_account2,cookie_account3
# خالی هم بذاری ریلز و پست‌های عمومی (با شانس کمتر) کار می‌کنن.
INSTAGRAM_SESSIONID=

# نام کاربری و رمز عبور اینستاگرام (برای ورود خودکار و استخراج sessionid)
# همچنین در ربات می‌توانید با دستور /login username password در هر زمان وارد شوید.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=


# ===== پروکسی (اختیاری ولی برای ضدریت‌لیمیت خیلی مؤثر) =====
# یه پروکسی residential بذار تا «استخراج لینک» از IP خانگی بره و IP هاست ریت‌لیمیت نشه.
# نکته‌ی مهم: فقط درخواستِ کوچیکِ استخراج از پروکسی می‌ره؛ خودِ بایت‌های ویدیو مستقیم از
# CDN اینستا دانلود می‌شن، برای همین سهمیه‌ی پروکسی خیلی کند تموم می‌شه (تا ~۵۰ برابر بیشتر ریلز).
# فرمت: http://user:pass@host:port  یا  socks5://user:pass@host:port
# (برای socks5 نصب کن: pip install "requests[socks]")
# پروکسی رایگان/دیتاسنتری روی اینستا کار نمی‌کنه — residential لازمه.
INSTAGRAM_PROXY=
